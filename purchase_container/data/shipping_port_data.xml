<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
        <!-- Partner Category for Shipping Ports -->
        <record id="partner_category_shipping_port" model="res.partner.category">
            <field name="name">Shipping Port</field>
            <field name="color">5</field>
        </record>

        <!-- US Destination Ports -->
        <record id="port_baltimore" model="res.partner">
            <field name="name">Port of Baltimore</field>
            <field name="is_company">True</field>
            <field name="street">2001 E McComas St</field>
            <field name="city">Baltimore, MD</field>
            <field name="zip">21230</field>
            <field name="country_id" ref="base.us" />
            <field name="partner_latitude">39.2667</field>
            <field name="partner_longitude">-76.5833</field>
            <field
            name="category_id"
            eval="[(6, 0, [ref('partner_category_shipping_port')])]"
        />
            <field name="comment">Primary destination port for PA warehouse</field>
        </record>

